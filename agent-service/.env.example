RAG_BASE_URL=http://127.0.0.1:8000
RAG_CHAT_PATH=/chat/
RAG_STREAM_PATH=/chat/stream
RAG_COLLECTION_NAME=rag

LLM_API_KEY=your_glm_api_key_here
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=glm-4-flash
# evaluator 质量判断用的便宜模型（planner 用上面的 LLM_MODEL）
EVALUATOR_MODEL=glm-4.5-flash

WEB_REPORT_PROJECT_DIR=../web-report-skill
WEB_REPORT_PYTHON=python
WEB_REPORT_OUTPUT_DIR=
WEB_REPORT_TIMEOUT=300

# 执行轨迹 JSONL 落盘目录（默认 agent-service/logs）
EVENT_LOG_DIR=
